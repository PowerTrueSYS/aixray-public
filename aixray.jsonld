  "name": "PTxray",
  "alternateName": "PTxray AIX and IBM i posture assessment",
  "description": "An open-source, read-only IBM AIX and IBM i posture assessment delivered as a single ksh88-compatible shell file with zero egress during assessment execution and explicit NOT_ASSESSED results when evidence is unavailable.",
  "url": "https://powertruesystems.com/aixray",
  "codeRepository": "https://github.com/PowerTrueSYS/ptxray-public",
  "downloadUrl": "https://powertruesystems.com/aixray/",
  "softwareVersion": "1.3.0",
  "applicationCategory": "System administration and security assessment",
  "applicationSubCategory": "IBM AIX and IBM i health check and posture assessment",
  "operatingSystem": [
    "IBM AIX 7.2",
    "IBM AIX 7.3",
    "IBM i 7.4",
    "IBM i 7.5"
  ],
  "programmingLanguage": "KornShell (ksh88-compatible AIX /bin/sh; IBM i PASE ksh)",
  "softwareRequirements": "AIX /bin/sh and standard AIX userland, or IBM i PASE ksh for the IBM i edition; no bash, Python, GNU userland, package installation, or assessment-time network access required.",
