  return ""
}

function validate_authored(depth,    copy_id, actual, expected) {
  copy_id = COPY_STACK[depth]
  actual = trim_space(AUTHORED_TEXT[depth])
  expected = canonical_copy(copy_id)
  if (expected != "") {
    if (actual != expected) \
      violation(copy_id, "authored copy does not match schema 1", actual)
  } else {
    violation(copy_id, "unknown authored-copy ID", actual)
  }
  validate_strong(actual, copy_id)
}

function identity_key_kind(key) {
  if (key == "host") return "host"
  if (key == "lpar") return "lpar"
  if (key == "ip") return "ip"
  if (key == "fqdn") return "fqdn"
  if (key == "mac") return "mac"
  if (key == "serial") return "serial"
  if (key == "wwpn") return "wwpn"
  if (key == "user") return "user"
  if (key == "path") return "path"
  if (key == "vg") return "vg"
  return ""
}

function validate_identity_registry(body, location,    items, count, item, pair, key, token, kind, seen) {
  if (body == "" || body !~ /^[A-Za-z0-9=_ -]+$/ \
      || body ~ /^ / || body ~ / $/ || body ~ /  /) {
    violation(location, "identity registry is outside the exact grammar", body)
    return
  }
  count = split(body, items, / +/)
  if (count < 1) {
    violation(location, "identity registry is empty", "")
    return
  }
  seen = " "
  for (item = 1; item <= count; item++) {
    if (split(items[item], pair, "=") != 2) {
      violation(location, "identity registry item is malformed", items[item])
      continue
    }
    key = pair[1]
    token = pair[2]
    kind = identity_key_kind(key)
    if (index(seen, " " key " ") > 0) {
      violation(location, "identity registry key is duplicated", key)
      continue
    }
    seen = seen key " "
    if (kind == "" || !(token in ISSUED) || ISSUED[token] != kind) \
      violation(location, \
        "identity registry item is not a matching issued pseudotoken", \
        items[item])
  }
}

function validate_comment(tag,    body) {
  validate_entities(tag, "html-comment")
  validate_strong(tag, "html-comment")
  if (tag !~ /^<!-- aixray-identities: [A-Za-z0-9=_ -]+ -->$/) {
    violation("html-comment", \
      "comment is outside the issued-identity grammar", tag)
    return
  }
  body = tag
  sub(/^<!-- aixray-identities: /, "", body)
  sub(/ -->$/, "", body)
  validate_identity_registry(body, "html-comment")
}

function handle_text(text,    family, location, depth) {
  if (text == "") return
  for (depth = 1; depth <= STACK_DEPTH; depth++) {
    if (OWN_ANNOTATION[depth] && FAMILY_STACK[depth] == "authored") \
      AUTHORED_TEXT[depth] = AUTHORED_TEXT[depth] decode_html(text)
  }
  if (STACK_DEPTH == 0) {
    validate_strong(text, "document")
    return
  }
  family = FAMILY_STACK[STACK_DEPTH]
  location = LOCATION_STACK[STACK_DEPTH]
  if (TAG_STACK[STACK_DEPTH] == "style") {
    validate_stylesheet(text, "report:presentation-css")
    return
  }
  validate_strong(text, location)
  if (TAG_STACK[STACK_DEPTH] == "title") {
    if (!valid_title_text(text)) \
      violation("report:document-title", "title is outside canonical grammar", \
        normalize_space(decode_html(text)))
  } else if (family == "identity") validate_identity(text, location)
  else if (family == "observed") validate_observed(text, location)
  else if (family == "evidence") validate_evidence(text, location)
  else if (family == "technical") validate_technical(text, location)
  else if (family == "" && !canonical_structural_text(text)) \
    violation("unclassified-content", "text is outside structural grammar", \
      normalize_space(decode_html(text)))
}

function forbidden_uri(value,    lower) {
  lower = tolower(decode_html(value))
  # network-lint: allow-next=1 -- URI scheme names are rejected data, never commands.
  return lower ~ /(^|[^A-Za-z0-9+.-])(https?:|ftp:|file:|mailto:|javascript:|vbscript:|\/\/)/ \
    || lower ~ /data:[ \t]*(text|application)\//
}

function canonical_font_payload(payload,    item) {
  for (item = 1; item <= CANONICAL_FONT_COUNT; item++) \
    if (payload == CANONICAL_FONT[item]) return 1
  return 0
}

function strip_font_payloads(text, location,    lower, marker, position, start, ending, character, payload) {
  marker = "data:font/woff2;base64,"
  lower = tolower(text)
  while ((position = index(lower, marker)) > 0) {
    start = position + char_count(marker)
    ending = start
    while ((character = substr(text, ending, 1)) != "" \
        && character ~ /[A-Za-z0-9+\/=]/) ending++
    if (ending == start) {
      violation(location, "embedded font payload is malformed", "")
      return text
    }
    payload = substr(text, start, ending - start)
    if (!canonical_font_payload(payload)) \
      violation(location, "embedded font payload is not canonical", "")
    text = substr(text, 1, position - 1) "[embedded-font]" substr(text, ending)
    lower = tolower(text)
  }
  return text
}

function validate_css(text, location,    safe, lower) {
  validate_entities(text, location)
  safe = strip_font_payloads(text, location)
  lower = tolower(decode_html(safe))
  if (index(lower, "\\") > 0 || index(lower, "/*") > 0) \
    violation(location, "CSS escapes or comments are outside canonical grammar", "")
  if (lower ~ /@import|expression[ \t]*\(|-moz-binding|behavior[ \t]*:/) \
    violation(location, "active CSS is forbidden", "")
  gsub(/url[(]\[embedded-font\][)]/, "", lower)
  if (lower ~ /url[ \t]*[(]/) \
    violation(location, "noncanonical CSS URL is forbidden", "")
  if (lower ~ /aixray-pseudonymize|aixray-change-summary|data-aixray/) \
    violation(location, "CSS may not target privacy disclosure fields", "")
  gsub(/[.]band::before[{]display:none[}]/, "", lower)
  gsub(/[.]cta,[.]mitigate[{]display:none[}]/, "", lower)
  if (lower ~ /display[ \t]*:[ \t]*none|visibility[ \t]*:[ \t]*hidden/ \
      || lower ~ /opacity[ \t]*:[ \t]*0([^.]|$)/ \
      || lower ~ /(^|[;{])(height|width)[ \t]*:[ \t]*0([^.]|$)/) \
    violation(location, "CSS may not hide review content", "")
  if (forbidden_uri(safe)) \
    violation(location, "remote or active CSS URI is forbidden", "")
  validate_strong(safe, location)
}

function canonical_stylesheet(payload,    item) {
  for (item = 1; item <= CANONICAL_STYLESHEET_COUNT; item++) \
    if (payload == CANONICAL_STYLESHEET[item]) return 1
  return 0
}

function validate_stylesheet(text, location,    safe, host_literal, date_literal) {
  validate_css(text, location)
  safe = strip_font_payloads(text, location)
  host_literal = "content:\"AIXray · " REPORT_HOST_TOKEN "\""
  date_literal = "content:\"" REPORT_DATE_VALUE "\""
  if (REPORT_HOST_TOKEN == "" || literal_count(safe, host_literal) != 1) {
    violation(location, "print-header host CSS is not canonical", "")
  } else {
    safe = replace_text(safe, host_literal, \
      "content:\"AIXray · [issued-host]\"")
  }
  if (REPORT_DATE_VALUE == "" || literal_count(safe, date_literal) != 1) {
    violation(location, "print-header date CSS is not canonical", "")
  } else {
    safe = replace_text(safe, date_literal, \
      "content:\"[report-date]\"")
  }
  if (!canonical_stylesheet(safe)) \
    violation(location, \
      "presentation CSS is not byte-equal to a canonical renderer style", "")
}

function valid_inline_style(value) {
  return value == "color:var(--amber)" \
    || value == "color:var(--green)" \
    || value == "color:var(--mute)" \
    || value == "color:var(--red)" \
    || value == "margin:0 0 6px" \
    || value == "padding:14px 32px;background:var(--cream);font-family:var(--sans);font-size:12px;color:var(--ink)" \
    || value == "padding:12px 32px;border-bottom:2px solid #C2703D;font-family:monospace" \
    || value == "padding:10px 32px;border-bottom:1px solid #D9D9D9;font-family:monospace" \
    || value ~ /^width:(0|[1-9][0-9]?|100)%$/
}

function validate_schema_attribute(name, value, location) {
  if (name == "data-aixray-field") {
    if (!allowed_family(value)) \
      violation(location, "unknown privacy field family", value)
  } else if (name == "data-aixray-location") {
    if (!valid_schema_location(value)) \
      violation(location, "unknown or noncanonical privacy location", value)
  } else if (name == "data-aixray-finding-id") {
    if (!valid_finding_id(value)) \
      violation(location, "unknown or noncanonical finding ID", value)
  } else if (name == "data-aixray-copy-id") {
    if (canonical_copy(value) == "") \
      violation(location, "unknown authored-copy ID", value)
  } else if (name == "data-aixray-container") {
    if (value != "fields") \
      violation(location, "unknown privacy field container", value)
  }
}

function validate_meta_content(tag, value, location,    meta_name) {
  meta_name = tolower(field_value(tag, "name"))
  if (meta_name == "aixray-report-version" \
      || meta_name == "aixray-privacy-schema") {
    if (value != "1") violation(location, "invalid schema marker value", value)
  } else if (meta_name == "aixray-report-date") {
    if (value !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) \
      violation(location, "invalid report date metadata", value)
    REPORT_DATE_VALUE = value
  } else if (meta_name == "aixray-report-host") {
    if (!(value in ISSUED) || ISSUED[value] != "host") \
      violation(location, "report host metadata is not an issued host token", value)
    REPORT_HOST_TOKEN = value
  } else if (meta_name == "viewport") {
    if (value != "width=device-width, initial-scale=1") \
      violation(location, "noncanonical viewport metadata", value)
  } else {
    violation(location, "content attribute lacks a known meta name", meta_name)
  }
}

function validate_tag_attributes(tag, location,    rest, name, lower_name, quote, ending, value, decoded, plan_attribute) {
  rest = tag
  sub(/^<[\/!?]?[A-Za-z][A-Za-z0-9:_.-]*/, "", rest)
  sub(/>$/, "", rest)
  while (rest != "") {
    sub(/^[ \t\r\n\/]+/, "", rest)
    if (rest == "") return
    if (!match(rest, /^[A-Za-z_:][A-Za-z0-9:_.-]*/)) {
      violation(location, "malformed or unconsumed attribute syntax", rest)
      return
    }
    name = substr(rest, 1, RLENGTH)
    lower_name = tolower(name)
    rest = substr(rest, RLENGTH + 1)
    sub(/^[ \t\r\n]*/, "", rest)
    if (substr(rest, 1, 1) != "=") {
      violation(location, "boolean or malformed attribute is forbidden", name)
      continue
    }
    rest = substr(rest, 2)
    sub(/^[ \t\r\n]*/, "", rest)
    quote = substr(rest, 1, 1)
    if (quote != "\"" && quote != "'") {
      violation(location, "unquoted attribute is forbidden", name)
      if (!match(rest, /^[^ \t\r\n>]+/)) return
      value = substr(rest, 1, RLENGTH)
      rest = substr(rest, RLENGTH + 1)
    } else {
      ending = index(substr(rest, 2), quote)
      if (ending == 0) {
        violation(location, "unterminated attribute is forbidden", name)
        return
      }
      value = substr(rest, 2, ending - 1)
      rest = substr(rest, ending + 2)
    }
    plan_attribute = canonical_plan_attribute(tag, lower_name, value)
    if (!plan_attribute) validate_entities(value, location)
    decoded = plan_attribute ? value : decode_html(value)
    if (lower_name ~ /^on/ || lower_name == "srcdoc" \
        || lower_name == "http-equiv") \
      violation(location, "active HTML attribute is forbidden", name)
    if (!plan_attribute && forbidden_uri(value)) \
      violation(location, "remote or active URI is forbidden", name)
    if (plan_attribute) {
      # Exact Plan attributes are also bound to one exact live-card substring
      # by validate_plan_contract; no generic URI or dynamic-field grammar is
      # permitted here.
    } else if (lower_name ~ /^data-aixray-(field|location|finding-id|copy-id|container)$/) {
      validate_schema_attribute(lower_name, decoded, location)
    } else if (lower_name == "data-aixray-identities") {
      if (decoded != value) \
        violation(location, \
          "identity registry attribute uses noncanonical entity encoding", \
          value)
      validate_identity_registry(decoded, location)
    } else if (lower_name == "style") {
      if (!valid_inline_style(decoded)) \
        violation(location, "inline style is outside canonical grammar", decoded)
      validate_css(value, location)
    }
    else {
      validate_strong(value, location)
      if (lower_name == "class" && !valid_class_value(decoded)) \
        violation(location, "unknown class token", decoded)
      else if (lower_name == "id" && !valid_structural_id(decoded)) \
        violation(location, "unknown structural ID", decoded)
      else if (lower_name == "data-finding-id" \
          && !valid_finding_id(decoded)) \
        violation(location, "unknown legacy finding ID", decoded)
      else if (lower_name == "aria-labelledby" \
          && decoded != "currency-heading" \
          && decoded != "exec-title" \
          && decoded != "start-here-title") \
        violation(location, "unknown ARIA reference", decoded)
      else if (lower_name == "charset" && tolower(decoded) != "utf-8") \
        violation(location, "unknown character encoding", decoded)
      else if (lower_name == "lang" && tolower(decoded) != "en") \
        violation(location, "unknown document language", decoded)
      else if (lower_name == "name" \
          && decoded !~ /^(aixray-report-version|aixray-privacy-schema|aixray-report-date|aixray-report-host|viewport)$/) \
        violation(location, "unknown metadata name", decoded)
      else if (lower_name == "content") \
        validate_meta_content(tag, decoded, location)
      else if ((lower_name == "data-action-index" \
          || lower_name == "data-priority" \
          || lower_name == "data-count" || lower_name == "colspan") \
          && decoded !~ /^[0-9]+$/) \
        violation(location, "non-numeric structural attribute", decoded)
      else if (lower_name == "data-severity" \
          && decoded !~ /^(high|med|low)$/) \
        violation(location, "unknown severity attribute", decoded)
      else if (lower_name == "data-tier" \
          && decoded !~ /^(Known-Exploited|Critical|High|Medium|Low|None|Unscored)$/) \
        violation(location, "unknown CVE tier attribute", decoded)
      else if (lower_name == "href" && decoded != "#") \
        violation(location, "nonlocal link remains", decoded)
      else if (lower_name == "role" \
          && decoded != "alert" && decoded != "note") \
        violation(location, "unknown role attribute", decoded)
      else if (lower_name == "alt" || lower_name == "title" \
          || lower_name == "placeholder" || lower_name == "value") \
        violation(location, "content-bearing attribute is not in schema 1", name)
      else if (lower_name != "class" && lower_name != "id" \
          && lower_name != "data-finding-id" \
          && lower_name != "aria-labelledby" && lower_name != "charset" \
          && lower_name != "lang" && lower_name != "name" \
          && lower_name != "content" && lower_name != "data-action-index" \
          && lower_name != "data-priority" && lower_name != "data-count" \
          && lower_name != "data-severity" \
          && lower_name != "data-tier" && lower_name != "colspan" \
          && lower_name != "href" && lower_name != "role" \
          && lower_name != "data-aixray-identities") \
        violation(location, "unknown structural attribute", name)
    }
  }
}

function validate_markup(tag,    lower, name, family, location, copy_id, container, inherited, depth, scan_tag, schema_value, legacy_value) {
  lower = tolower(tag)
  if (lower ~ /^<!--/) {
    COMMENT_COUNT++
    validate_comment(tag)
    return
  }
  if (lower ~ /^<!doctype/) {
    DOCTYPE_COUNT++
    if (tag != "<!doctype html>") \
      violation("markup", "doctype is outside the exact canonical grammar", tag)
    return
  }
  if (tag !~ /^<\/?[A-Za-z]/) {
    violation("markup", "tag has a noncanonical lexical opening", tag)
    return
  }
  if (lower ~ /^<script([ \t>])|^<iframe([ \t>])|^<object([ \t>])|^<embed([ \t>])|^<base([ \t>])|^<form([ \t>])/) \
    violation("markup", "active or embedded content is forbidden", tag_name(tag))
  if (forbidden_uri(strip_canonical_plan_resources(tag))) \
    violation("markup", "remote or active resource is forbidden", tag_name(tag))

  name = tag_name(tag)
  if (name != "" && !allowed_element(name)) \
    violation("markup", "element is outside the schema 1 allowlist", name)
  if (substr(lower, 1, 2) == "</") {
    if (tag != "</" name ">") {
      violation("markup", "closing tag is outside the exact canonical grammar", tag)
      return
    }
    if (STACK_DEPTH == 0 || TAG_STACK[STACK_DEPTH] != name) {
      violation("markup", "malformed or mismatched closing tag", name)
      return
    }
    if (OWN_ANNOTATION[STACK_DEPTH] \
        && FAMILY_STACK[STACK_DEPTH] == "authored") \
      validate_authored(STACK_DEPTH)
    delete TAG_STACK[STACK_DEPTH]
    delete FAMILY_STACK[STACK_DEPTH]
    delete LOCATION_STACK[STACK_DEPTH]
    delete COPY_STACK[STACK_DEPTH]
    delete OWN_ANNOTATION[STACK_DEPTH]
    delete AUTHORED_TEXT[STACK_DEPTH]
    STACK_DEPTH--
    return
  }
  if (tag ~ /\/>$/ && !is_void_element(name)) {
    violation("markup", "non-void element cannot use self-closing syntax", name)
    return
  }
  if (name == "style") STYLE_COUNT++

  validate_tag_attributes(tag, location != "" ? location : name)

  if (field_count(tag, "data-aixray-field") > 1 \
      || field_count(tag, "data-aixray-location") > 1 \
      || field_count(tag, "data-aixray-copy-id") > 1 \
      || field_count(tag, "data-aixray-container") > 1 \
      || field_count(tag, "data-aixray-identities") > 1) \
    violation("markup", "duplicate privacy annotation", name)

  family = field_value(tag, "data-aixray-field")
  location = field_value(tag, "data-aixray-location")
  copy_id = field_value(tag, "data-aixray-copy-id")
  container = field_value(tag, "data-aixray-container")
  if (container != "" \
      && (container != "fields" || family != "" \
        || location != "" || copy_id != "")) \
    violation("privacy-container", \
      "privacy field container is unknown or contradictory", container)
  if (name == "td" && family == "" && container != "fields") \
    violation("assessment-cell", "unclassified assessment cell", "")
  if (family != "" && !allowed_family(family)) \
    violation(location, "unknown privacy field family", family)
  if (family == "authored") {
    if (copy_id == "") \
      violation("authored-copy", "authored field lacks copy ID", "")
    if (location != "") \
      violation(copy_id, "authored field has contradictory location", location)
  } else if (family != "") {
    if (location == "") \
      violation("privacy-field", "dynamic field lacks stable location", family)
    if (copy_id != "") \
      violation(location, "dynamic field has contradictory copy ID", copy_id)
  }
  inherited = STACK_DEPTH > 0 ? FAMILY_STACK[STACK_DEPTH] : ""
  if (family != "" && inherited != "" && family != inherited) \
    violation(location, "contradictory nested privacy field", family)

  scan_tag = tag
  schema_value = field_value(tag, "data-aixray-location")
  if (schema_value != "") scan_tag = replace_text(scan_tag, schema_value, "")
  schema_value = field_value(tag, "data-aixray-copy-id")
  if (schema_value != "") scan_tag = replace_text(scan_tag, schema_value, "")
  schema_value = field_value(tag, "data-aixray-container")
  if (schema_value != "") scan_tag = replace_text(scan_tag, schema_value, "")
  schema_value = field_value(tag, "data-aixray-finding-id")
  legacy_value = field_value(tag, "data-finding-id")
  if (legacy_value != "" \
      && schema_value != "" && legacy_value != schema_value) \
    violation("markup", "legacy and privacy finding IDs disagree", legacy_value)
  if (schema_value != "") scan_tag = replace_text(scan_tag, schema_value, "")
  schema_value = field_value(tag, "data-aixray-field")
  if (schema_value != "") scan_tag = replace_text(scan_tag, schema_value, "")
  scan_tag = strip_canonical_plan_resources(scan_tag)
  validate_strong(scan_tag, location != "" ? location : "markup")
  if (is_void_element(name) || tag ~ /\/>$/) return

  STACK_DEPTH++
  depth = STACK_DEPTH
  TAG_STACK[depth] = name
  OWN_ANNOTATION[depth] = family != ""
  if (family == "" && depth > 1) {
    FAMILY_STACK[depth] = FAMILY_STACK[depth - 1]
    LOCATION_STACK[depth] = LOCATION_STACK[depth - 1]
    COPY_STACK[depth] = COPY_STACK[depth - 1]
  } else {
    FAMILY_STACK[depth] = family
    LOCATION_STACK[depth] = location
    COPY_STACK[depth] = copy_id
  }
  AUTHORED_TEXT[depth] = ""
}

function parse_document(document,    remainder, opening, closing, text, tag) {
  remainder = document
  while (remainder != "") {
    opening = index(remainder, "<")
    if (opening == 0) {
      handle_text(remainder)
      break
    }
    text = substr(remainder, 1, opening - 1)
    handle_text(text)
    remainder = substr(remainder, opening)
    closing = index(remainder, ">")
    if (closing == 0) {
      violation("markup", "unterminated markup", "")
      break
    }
    tag = substr(remainder, 1, closing)
    validate_markup(tag)
    remainder = substr(remainder, closing + 1)
  }
  if (STACK_DEPTH != 0) \
    violation("markup", "unclosed markup remains", TAG_STACK[STACK_DEPTH])
}

BEGIN {
  VIOLATION_COUNT = 0
  STACK_DEPTH = 0
  initialize_plan_qr_rows()
  load_canonical_renderer_assets()
  load_schema_contract()
  load_structural_contract()
  load_tokens()
}

{
  DOCUMENT = DOCUMENT $0 "\n"
}

END {
  validate_plan_contract(DOCUMENT)
  if (literal_count(DOCUMENT, "<meta name=\"aixray-report-version\" content=\"1\">") != 1) \
    violation("document", "report-version marker is missing or duplicated", "")
  if (literal_count(DOCUMENT, "<meta name=\"aixray-privacy-schema\" content=\"1\">") != 1) \
    violation("document", "privacy-schema 1 marker is missing or duplicated", "")
  if (literal_count(tolower(DOCUMENT), "<html") != 1 \
      || literal_count(tolower(DOCUMENT), "</html>") != 1 \
      || literal_count(tolower(DOCUMENT), "<body") != 1 \
      || literal_count(tolower(DOCUMENT), "</body>") != 1) \
    violation("document", "complete HTML envelope is not provable", "")
  if (literal_count(DOCUMENT, \
      "class=\"aixray-pseudonymize-notice\"") != 1 \
      || literal_count(DOCUMENT, \
        "data-aixray-copy-id=\"review-disclosure-v1\"") != 1) \
    violation("review-disclosure", \
      "pseudonymization notice is missing or duplicated", "")
  if (literal_count(DOCUMENT, "class=\"aixray-change-summary\"") != 1 \
      || literal_count(DOCUMENT, \
        "data-aixray-location=\"review:change-summary\"") != 1 \
      || literal_count(DOCUMENT, "__AIXRAY_CHANGE_SUMMARY_V1__") != 0) \
    violation("review:change-summary", \
      "change summary is missing, duplicated, or unresolved", "")

  parse_document(DOCUMENT)
  if (DOCTYPE_COUNT != 1) \
    violation("document", "exactly one canonical doctype is required", "")
  if (STYLE_COUNT != 1) \
    violation("document", "exactly one canonical presentation style is required", "")
  close(violation_out)
  if (VIOLATION_COUNT > 0) exit 1
  print "independent-output-validation\tPASS" > result_out
  close(result_out)
}
