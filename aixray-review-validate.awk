  if (copy_id == "product:brand-name-v1") return "AIXray"
  if (copy_id == "product:brand-tag-compliance-v1") \
    return "by PowerTrue Systems · AIX · IBM Power · VIOS"
  if (copy_id == "product:brand-tag-native-v1") \
