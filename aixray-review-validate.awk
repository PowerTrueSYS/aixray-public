  if (copy_id == "native:cvss-incomplete-detail-v1") \
    return "exposure record(s) came from a row whose CVSS field was incomplete or malformed. Recovered scores remain listed; unscored CVEs are NOT ASSESSED and are not guessed into the None tier."
  if (copy_id == "native:no-action-findings-v1") \
    return "No FAIL/WARN findings were emitted in this run."
