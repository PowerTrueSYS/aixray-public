function known_ffiec_control(value) {
  return value == "II.C.7" || value == "II.C.10" \
    || value == "II.C.11" || value == "II.C.15" \
    || value == "II.C.21" || value == "II.C.22" \
    || value == "III.B"
}

function valid_schema_location(value,    pieces, count) {
  if (value in KNOWN_REPORT_LOCATION) return 1
  count = split(value, pieces, ":")
  if (count == 3 && pieces[1] == "finding") \
    return valid_finding_id(pieces[2]) && (pieces[3] in KNOWN_FINDING_SLOT)
  if (count == 3 && pieces[1] == "currency") \
    return (pieces[2] in KNOWN_CURRENCY_SOURCE) \
      && (pieces[3] in KNOWN_CURRENCY_SLOT)
  if (count == 3 && pieces[1] == "report" \
      && pieces[2] == "exec-area-count") \
    return pieces[3] in KNOWN_EXEC_CATEGORY
  if (count == 3 && pieces[1] == "report" \
      && (pieces[2] == "exec-section" \
          || pieces[2] == "exec-section-count")) \
    return pieces[3] ~ /^[1-9][0-9]*([.][1-9][0-9]*)?$/
  if (pieces[1] != "control" || !(pieces[count] in KNOWN_CONTROL_SLOT)) \
    return 0
  if (count == 3) return known_cis_control(pieces[2])
  if (count == 4 && pieces[2] == "stig") \
    return pieces[3] ~ /^V-[0-9]+$/
  if (count == 4 && pieces[2] == "ffiec") \
    return known_ffiec_control(pieces[3])
  return 0
}

function valid_class_value(value,    pieces, count, item) {
  count = split(value, pieces, /[ \t\r\n]+/)
  if (count < 1) return 0
  for (item = 1; item <= count; item++) \
    if (pieces[item] == "" || !(pieces[item] in KNOWN_CLASS)) return 0
  return 1
}

function valid_structural_id(value) {
  return value == "currency-heading" || value == "cvss-ladder" \
    || value == "exec-title" \
    || value == "plan-card-heading" \
    || value == "plan-qr-description" || value == "plan-qr-title" \
    || value == "remediation-actions" \
    || value == "start-here" || value == "start-here-title"
}

function token_shape(value) {
  return value ~ /^host-([A-Z]|[0-9]+)$/ \
    || value ~ /^(lpar|ip|mac|fqdn|serial|wwpn|user|path|vg)-[0-9]+$/
}

function valid_token_kind(value) {
  return value == "host" || value == "lpar" || value == "ip" \
    || value == "mac" || value == "fqdn" || value == "serial" \
    || value == "wwpn" || value == "user" || value == "path" \
    || value == "vg"
}

function violation(location, reason, value,    line) {
  if (location == "") location = "document"
  line = location "\t" reason
  # The candidate value is untrusted customer-derived content. A stable
  # location and bounded reason are sufficient to remediate a rejection;
  # never copy the value into a failure artifact.
  print line > violation_out
  VIOLATION_COUNT++
}

function load_tokens(    line, pieces, count, token, kind) {
  while ((getline line < token_in) > 0) {
    count = split(line, pieces, "\t")
    if (count != 2) {
      violation("token-registry", "malformed issued-token row", "")
      continue
    }
    token = pieces[1]
    kind = pieces[2]
    if (!token_shape(token) || !valid_token_kind(kind)) {
      violation("token-registry", "invalid issued token or kind", token)
      continue
    }
    if (token in ISSUED) {
      violation("token-registry", "duplicate issued token", token)
      continue
    }
    ISSUED[token] = kind
    ISSUED_COUNT++
  }
  close(token_in)
  if (ISSUED_COUNT == 0) \
    violation("token-registry", "no issued tokens were supplied", "")
}

function decimal_byte(value,    parts, count, item) {
  count = split(value, parts, ".")
  if (count != 4) return 0
  for (item = 1; item <= 4; item++) {
    if (parts[item] !~ /^[0-9]+$/) return 0
    if (parts[item] + 0 > 255) return 0
  }
  return 1
}

function colon_hardware(value,    parts, count, item) {
  count = split(value, parts, ":")
  if (count != 6 && count != 8) return 0
  for (item = 1; item <= count; item++) {
    if (char_count(parts[item]) != 2 || parts[item] !~ /^[0-9A-Fa-f][0-9A-Fa-f]$/) \
      return 0
  }
  return 1
}

function dash_uuid(value,    parts, count) {
  count = split(value, parts, "-")
  return count == 5 \
    && char_count(parts[1]) == 8 && parts[1] !~ /[^0-9A-Fa-f]/ \
    && char_count(parts[2]) == 4 && parts[2] !~ /[^0-9A-Fa-f]/ \
    && char_count(parts[3]) == 4 && parts[3] !~ /[^0-9A-Fa-f]/ \
    && char_count(parts[4]) == 4 && parts[4] !~ /[^0-9A-Fa-f]/ \
    && char_count(parts[5]) == 12 && parts[5] !~ /[^0-9A-Fa-f]/
}

function secret_residual(text,    lower) {
  lower = tolower(decode_html(text))
  if (index(lower, "authorization: bearer ") > 0 \
      && index(lower, "authorization: bearer [redacted-secret]") == 0) return 1
  if (index(lower, "private key-----") > 0) return 1
  if (lower ~ /(^|[^a-z0-9_])(password|passwd|pwd|api_key|apikey|api-key|credential|secret|token|community|private_key|private-key)[ \t]*[:=][ \t]*[^ \t\r\n;<]+/ \
      && index(lower, "[redacted-secret]") == 0) return 1
  if (lower ~ /gecos[ \t]*[:=]/ \
      && index(lower, "[redacted]") == 0 \
      && index(lower, "[redacted-evidence-line]") == 0) return 1
  return 0
}

function aws_access_key(value,    rest) {
  if (char_count(value) != 20 || substr(value, 1, 4) != "AKIA") return 0
  rest = substr(value, 5)
  return rest != "" && rest !~ /[^A-Z0-9]/
}

function high_entropy_value(value,    size, has_lower, has_upper, has_digit) {
  size = char_count(value)
  if (valid_schema_location(value)) return 0
  if (aws_access_key(value)) return 1
  if (size < 20 || value ~ /^(CVE|APAR)-/) return 0
  has_lower = value ~ /[a-z]/
  has_upper = value ~ /[A-Z]/
  has_digit = value ~ /[0-9]/
  if (has_lower && has_upper && has_digit) return 1
  if (size >= 24 && value !~ /[^0-9A-Fa-f]/) return 1
  if (size >= 32 && value !~ /[^A-Za-z0-9+\/=]/) return 1
  return 0
}

function ipv6_shape(value,    base, percent, parts, count, item, colons) {
  base = value
  percent = index(base, "%")
  if (percent > 0) {
    if (substr(base, percent + 1) !~ /^[A-Za-z][A-Za-z0-9_.-]*$/) return 0
    base = substr(base, 1, percent - 1)
  }
  if (base !~ /:/ || base ~ /[^0-9A-Fa-f:]/) return 0
  colons = gsub(/:/, ":", base)
  if (colons < 2) return 0
  count = split(base, parts, ":")
  for (item = 1; item <= count; item++) {
    if (parts[item] != "" \
        && (char_count(parts[item]) > 4 || parts[item] ~ /[^0-9A-Fa-f]/)) \
      return 0
  }
  return 1
}

function product_or_technical_name(value,    lower) {
  lower = tolower(value)
  if (lower == "powertruesystems.com" || lower == "openssh.com" \
      || lower == "review@powertruesystems.com") return 1
  if (lower == "flrtvc.ksh" || lower == "apar.csv") return 1
  if (lower ~ /^(bos|devices|x11|openssh|openssl|rsct|cluster|gpfs|perl|printers|sysmgt|java[0-9_]*)[.]/) \
    return 1
  return 0
}

function suspicious_domain(value,    lower) {
  lower = tolower(value)
  if (product_or_technical_name(value)) return 0
  return lower ~ /^[a-z0-9-]+([.][a-z0-9-]+)+$/ \
    && lower ~ /[.](com|net|org|internal|example|local|corp)$/
}

function grammatical_version(text, value,    lower, candidate) {
  if (decimal_byte(value)) return 0
  lower = tolower(decode_html(text))
  candidate = tolower(value)
  return index(lower, "vios=" candidate) > 0 \
    || index(lower, "hmc=" candidate) > 0 \
    || index(lower, "version=" candidate) > 0 \
    || index(lower, "version " candidate) > 0 \
    || index(lower, "level=" candidate) > 0 \
    || index(lower, "oslevel=" candidate) > 0 \
    || index(lower, "firmware=" candidate) > 0
}

function technical_ipv4_allowed(location, value,    pieces, count) {
  count = split(location, pieces, ":")
  if (count == 3 && pieces[1] == "control" \
      && pieces[3] == "id" && pieces[2] == value) \
    return known_cis_control(value)
  if (count == 3 && pieces[1] == "finding" \
      && (pieces[3] == "cis" || pieces[3] == "controls")) \
    return known_cis_control(value)
  return 0
}

function currency_sha256_allowed(location, value,    pieces, count, digest) {
  count = split(location, pieces, ":")
  if (count != 3 || pieces[1] != "currency" \
      || !(pieces[2] in KNOWN_CURRENCY_SOURCE) \
      || pieces[3] != "version") return 0
  if (char_count(value) != 71 || substr(value, 1, 7) != "sha256:") return 0
  digest = substr(value, 8)
  return digest != "" && digest !~ /[^0-9a-f]/
}

function numeric_dotted_version(value,    pieces, count, item) {
  if (substr(value, 1, 1) == "v") value = substr(value, 2)
  count = split(value, pieces, "[.]")
  if (count < 2 || count > 4) return 0
  for (item = 1; item <= count; item++) \
    if (pieces[item] == "" || pieces[item] ~ /[^0-9]/) return 0
  return 1
}

function currency_version_allowed(location, value,    pieces, count, source) {
  if (value == "unknown" || currency_sha256_allowed(location, value)) return 1
  count = split(location, pieces, ":")
  if (count != 3 || pieces[1] != "currency" || pieces[3] != "version") return 0
  source = pieces[2]
  if (source == "ibm-apar-csv") return canonical_currency_date(value)
  if (source == "ibm-flrtvc") return numeric_dotted_version(value)
  if (source == "cis-ibm-aix") return numeric_dotted_version(value)
  if (source == "disa-stig-ibm-aix-7") return value ~ /^V[0-9]+R[0-9]+$/
  return 0
}

function validate_strong(text, location,    plain, words, count, item, value, lower, email_parts) {
  validate_entities(text, location)
  plain = decode_html(text)
  if (secret_residual(plain)) \
    violation(location, "secret-shaped content remains", trim_space(plain))
  count = split(plain, words, /[ \t\r\n,;(){}<>"'=]+/)
  for (item = 1; item <= count; item++) {
    value = strip_edges(words[item])
    if (value == "") continue
    lower = tolower(value)
    if (token_shape(value)) {
      if (!(value in ISSUED)) \
        violation(location, "unissued pseudotoken-shaped value", value)
      continue
    }
    if (decimal_byte(value)) {
      if (grammatical_version(plain, value) \
          || technical_ipv4_allowed(location, value)) continue
      violation(location, "IPv4-shaped identifier remains", value)
      continue
    }
    if (colon_hardware(value)) {
      violation(location, "MAC/WWPN-shaped identifier remains", value)
      continue
    }
    if (dash_uuid(value)) {
      violation(location, "UUID-shaped identifier remains", value)
      continue
    }
    if (ipv6_shape(value)) {
      violation(location, "IPv6-shaped identifier remains", value)
      continue
    }
    if (high_entropy_value(value)) {
      if (currency_sha256_allowed(location, value)) continue
      violation(location, "secret or high-entropy value remains", value)
      continue
    }
    if (index(value, "@") > 0) {
      if (split(value, email_parts, "@") == 2 \
          && email_parts[1] ~ /^[A-Za-z0-9._%+-]+$/ \
          && suspicious_domain(email_parts[2])) {
        violation(location, "email-shaped identifier remains", value)
        continue
      }
    }
    if (suspicious_domain(value)) \
      violation(location, "DNS-shaped identifier remains", value)
  }
}

function exact_status(value) {
  return value == "PASS" || value == "WARN" || value == "FAIL" \
    || value == "NA" || value == "NOT ASSESSED" \
    || value == "NOT APPLICABLE" || value == "NOT_ASSESSED" \
    || value == "NOT_APPLICABLE"
}

function exact_risk(value) {
  return value == "Critical" || value == "High" \
    || value == "Medium" || value == "Low"
}

function exact_severity(value) {
  return value == "critical" || value == "high" \
    || value == "medium" || value == "med" || value == "low"
}

function exact_cve_tier(value) {
  return value == "—" || value == "Known-Exploited" \
    || value == "Critical" || value == "Critical / HIPER" \
    || value == "High" || value == "Medium" || value == "Low" \
    || value == "None" || value == "Unscored"
}

function exact_optional_currency_warning(value,    count, noun, pronoun, expected) {
  for (count = 1; count <= 4; count++) {
    noun = "sources were"
    pronoun = "their"
    if (count == 1) {
      noun = "source was"
      pronoun = "its"
    }
    expected = "CURRENCY UNVERIFIED — " count \
      " optional operator-supplied " noun " not supplied; " pronoun \
      " vulnerability and firmware currency cross-checks are NOT ASSESSED. " \
      "Supply local inputs: --definitions-bundle, --flrtvc-report, or " \
      "--flrtvc-ksh with --flrtvc-apar-csv; for Contract-v2, use " \
      "--kev-json and --firmware-lifecycle-report."
    if (value == expected) return 1
  }
  return 0
}

function exact_control_reference(value) {
  return known_cis_control(value) || value == "cis-l1" \
    || value == "cis-l2" \
    || value ~ /^stig:V-[0-9]+$/ \
    || (substr(value, 1, 6) == "ffiec:" \
      && known_ffiec_control(substr(value, 7)))
}

function validate_control_list(value, location,    normalized, pieces, count, item, word) {
  normalized = value
  gsub(/,/, " ", normalized)
  count = split(normalized, pieces, /[ \t\r\n]+/)
  for (item = 1; item <= count; item++) {
    word = strip_edges(pieces[item])
    if (word == "" || word == "—" || exact_status(word) \
        || exact_control_reference(word)) continue
    violation(location, "technical control value is outside canonical grammar", word)
  }
}

function exact_summary_location(value) {
  return valid_schema_location(value) \
    || value == "report:structural" \
    || value == "report:html-comment" \
    || value == "report:print-header" \
    || value == "report:document-title" \
    || value == "report:host-meta" || value == "report:date-meta" \
    || value == "report:metadata" || value == "assessment-cell" \
    || canonical_copy(value) != ""
}

function validate_change_summary(value, location,    pieces, count, item, word) {
  if (value == "" || value == "Automated change summary" \
      || value in ISSUED) return
  count = split(value, pieces, /[ \t\r\n]+/)
  for (item = 1; item <= count; item++) {
    word = strip_edges(pieces[item])
    if (word == "" || word == "—" || word == "replacement" \
        || word == "removal" || word == "at" \
        || word == "occurrence" || word == "occurrences" \
        || word == "occurrence(s)" || word == "occurrence(s" \
        || word ~ /^[0-9]+$/ \
        || word in ISSUED || exact_summary_location(word) \
        || word == "host" || word == "lpar" || word == "ip" \
        || word == "mac" || word == "fqdn" || word == "serial" \
        || word == "wwpn" || word == "user" || word == "path" \
        || word == "vg" \
        || word == "secret" || word == "GECOS" \
        || word == "secret-in-removed-field" \
        || word == "GECOS-in-removed-field" \
        || word == "whole-evidence-field" \
        || word == "generated-time-locality" \
        || word == "remote-resource") continue
    violation(location, "change summary is outside canonical grammar", word)
  }
}

function dynamic_bytes_complete(text, location, allow_punctuation,    probe) {
  probe = decode_html(text)
  if (allow_punctuation) {
    gsub(/—/, "-", probe)
    gsub(/·/, ".", probe)
  }
  if (probe ~ /^[\t\r\n -~]*$/) return 1
  violation(location, "non-ASCII or unconsumed dynamic content remains", \
    trim_space(decode_html(text)))
  return 0
}

function canonical_currency_date(value,    pieces, count, year, month, day, limit, leap) {
  if (value !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) return 0
  count = split(value, pieces, "-")
  if (count != 3) return 0
  year = pieces[1] + 0
  month = pieces[2] + 0
  day = pieces[3] + 0
  if (month < 1 || month > 12 || day < 1) return 0
  limit = 31
  if (month == 4 || month == 6 || month == 9 || month == 11) limit = 30
  if (month == 2) {
    leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
    limit = leap ? 29 : 28
  }
  return day <= limit
}

function validate_technical(text, location,    value, pieces, count, slot, expected, prefix, suffix) {
  if (!dynamic_bytes_complete(text, location, 1)) return
  value = normalize_space(decode_html(text))
  if (value == "") return
  if (location == "review:change-summary") {
    validate_change_summary(value, location)
    return
  }
  if (location == "report:generated-date") {
    if (value !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) \
      violation(location, "generated date is outside canonical grammar", value)
    return
  }
  if (location == "report:pass-count" || location == "report:warn-count" \
      || location == "report:fail-count" \
      || location == "report:not-applicable-count" \
      || location == "report:not-assessed-count" \
      || location == "report:cvss-count" \
      || location == "report:cvss-incomplete-count") {
    if (value !~ /^[0-9]+$/) \
      violation(location, "report count is outside canonical grammar", value)
    return
  }
  if (location == "report:pass-rate") {
    if (value !~ /^[0-9]+%$/) \
      violation(location, "pass rate is outside canonical grammar", value)
    return
  }
  if (location == "report:compliance-label") {
    if (value != "DISA STIG (IBM AIX 7.x)" \
        && value != "PowerTrue CIS L1 cross-check" \
        && value != "PowerTrue CIS L2 cross-check" \
        && value != "FFIEC IT Handbook") \
      violation(location, "compliance label is outside canonical grammar", value)
    return
  }
  if (location == "report:compliance-standard") {
    if (value != "DISA STIG for IBM AIX 7.x" \
        && value != "PowerTrue-authored CIS L1 numeric cross-check" \
        && value != "PowerTrue-authored CIS L2 numeric cross-check" \
        && value != "FFIEC IT Handbook alignment") \
      violation(location, "compliance standard is outside canonical grammar", value)
    return
  }
  if (location == "report:report-kind") {
    if (value != "System Health Check" \
        && value != "Virtual I/O Server health check") \
      violation(location, "report kind is outside canonical grammar", value)
    return
  }
  if (location == "report:title-kind") {
    if (value != "Posture snapshot" && value != "VIOS posture snapshot") \
      violation(location, "title kind is outside canonical grammar", value)
    return
  }
  if (location == "report:cvss-tier") {
    if (!exact_cve_tier(value)) \
      violation(location, "CVSS tier is outside canonical grammar", value)
    return
  }
  if (location == "report:kev-tier") {
    if (value != "Known-Exploited") \
      violation(location, "KEV tier is outside canonical grammar", value)
    return
  }
  if (location == "report:kev-status") {
    if (value != "NOT ASSESSED") \
      violation(location, "KEV status is outside canonical grammar", value)
    return
  }
  if (location == "report:currency-warning") {
    prefix = "CURRENCY UNVERIFIED — "
    suffix = " Findings below must not be treated as a current clean assessment."
    if (!exact_optional_currency_warning(value) \
        && (index(value, prefix) != 1 \
        || char_count(value) <= char_count(prefix) + char_count(suffix) \
        || substr(value, char_count(value) - char_count(suffix) + 1) != suffix)) \
      violation(location, "currency warning is outside canonical grammar", value)
    return
  }
  if (location == "report:exec-overall") {
    if (value == "Overall:") return
    if (value ~ /^[0-9]+ of [0-9]+ assessed (controls|checks) passed$/) return
    if (value ~ /^· [0-9]+ not assessed$/) return
    if (value ~ /^· [0-9]+ n\/a$/) return
    if (value ~ /^\([0-9]+%\)[.]$/) return
    if (value == "Not-assessed counts appear as the solid grey segment; not-applicable counts appear as the outlined pale segment. Absent segments mean zero.") return
    if (value ~ /^\([0-9]+%\)[.] Not-assessed counts appear as the solid grey segment; not-applicable counts appear as the outlined pale segment. Absent segments mean zero.$/) return
    if (value ~ /^— [0-9]+ findings need attention and are listed below; pass and not-applicable controls are accounted for in the counts above rather than repeated in the list[.]$/) return
    if (value ~ /^— [0-9]+ findings in total, every one listed in the detail below[.]$/) return
    if (value ~ /^— [0-9]+ findings need attention and are listed below; pass and not-applicable controls are accounted for in the counts above rather than repeated in the list[.] Not-assessed counts appear as the solid grey segment; not-applicable counts appear as the outlined pale segment. Absent segments mean zero.$/) return
    if (value ~ /^— [0-9]+ findings in total, every one listed in the detail below[.] Not-assessed counts appear as the solid grey segment; not-applicable counts appear as the outlined pale segment. Absent segments mean zero.$/) return
    if (value ~ /^\([0-9]+%\)[.] — [0-9]+ findings need attention and are listed below; pass and not-applicable controls are accounted for in the counts above rather than repeated in the list[.] Not-assessed counts appear as the solid grey segment; not-applicable counts appear as the outlined pale segment. Absent segments mean zero.$/) return
    if (value ~ /^\([0-9]+%\)[.] — [0-9]+ findings in total, every one listed in the detail below[.] Not-assessed counts appear as the solid grey segment; not-applicable counts appear as the outlined pale segment. Absent segments mean zero.$/) return
    violation(location, "exec-overall text is outside canonical grammar", value)
    return
  }
  count = split(location, pieces, ":")
  slot = pieces[count]
  if (pieces[1] == "report" && pieces[2] == "exec-area-count") {
    if (value ~ /^[0-9]+ of [0-9]+ pass( ·)?$/) return
    if (value == "·") return
    if (value ~ /^[0-9]+ (fail|warn|not assessed|n\/a)$/) return
    if (value == "no findings emitted") return
    violation(location, "exec-area-count text is outside canonical grammar", value)
    return
  }
  if (pieces[1] == "report" && pieces[2] == "exec-section-count") {
    if (value ~ /^[0-9]+ of [0-9]+ pass( · [0-9]+ fail)?( · [0-9]+ warn)?( · [0-9]+ not assessed)?( · [0-9]+ n\/a)?$/) return
    if (value == "no assessed controls") return
    violation(location, "exec-section-count text is outside canonical grammar", value)
    return
  }
  if (pieces[1] == "report" && pieces[2] == "exec-section") {
    if (value ~ /^section [1-9][0-9]*([.][1-9][0-9]*)?$/) return
    violation(location, "exec-section text is outside canonical grammar", value)
    return
  }
  if (count == 3 && pieces[1] == "currency") {
    if (!(pieces[2] in KNOWN_CURRENCY_SOURCE) \
        || !(slot in KNOWN_CURRENCY_SLOT)) {
      violation(location, "currency field has no canonical grammar", value)
      return
    }
    if (slot == "source") {
      if (value != pieces[2]) \
        violation(location, "currency source does not match its schema location", value)
    } else if (slot == "version") {
      if (!currency_version_allowed(location, value)) \
        violation(location, "currency version is outside canonical grammar", value)
    } else if (slot == "as-of") {
      if (value != "unknown" && !canonical_currency_date(value)) \
        violation(location, "currency as-of date is outside canonical grammar", value)
    } else if (slot == "age") {
      if (value != "unknown" && value !~ /^-?[0-9]+ days$/) \
        violation(location, "currency age is outside canonical grammar", value)
    } else if (slot == "limit") {
      if (value !~ /^[0-9]+ days$/) \
        violation(location, "currency limit is outside canonical grammar", value)
    } else if (slot == "status") {
      if (value != "CURRENT" && value != "STALE" && value != "FUTURE" \
          && value != "UNKNOWN" && value != "INVALID") \
        violation(location, "currency status is outside canonical grammar", value)
    }
    return
  }
  if (pieces[1] == "control" && slot == "id") {
    expected = substr(location, 9, char_count(location) - 11)
    if (value != expected || !exact_control_reference(value)) \
      violation(location, "control ID does not match its schema location", value)
    return
  }
  if (pieces[1] == "control" && slot == "status") {
    if (!exact_status(value)) \
      violation(location, "control status is outside canonical grammar", value)
    return
  }
  if (pieces[1] == "finding" && slot == "status") {
    if (!exact_status(value)) \
      violation(location, "finding status is outside canonical grammar", value)
    return
  }
  if (pieces[1] == "finding" && slot == "severity") {
    if (!exact_severity(value)) \
      violation(location, "finding severity is outside canonical grammar", value)
    return
  }
  if (pieces[1] == "finding" && slot == "risk") {
    if (!exact_risk(value)) \
      violation(location, "finding risk is outside canonical grammar", value)
    return
  }
  if (pieces[1] == "finding" && slot == "top-risk-rank") {
    if (value !~ /^(FAIL|WARN) · (critical|high|medium|med|low)$/) \
      violation(location, "top-risk rank is outside canonical grammar", value)
    return
  }
  if (pieces[1] == "finding" && slot == "action-priority") {
    if (value !~ /^[0-9]+$/) \
      violation(location, "action priority is outside canonical grammar", value)
    return
  }
  if (pieces[1] == "finding" && slot == "cve-tier") {
    if (!exact_cve_tier(value)) \
      violation(location, "finding CVE tier is outside canonical grammar", value)
    return
  }
  if (pieces[1] == "finding" \
      && (slot == "cis" || slot == "controls")) {
    validate_control_list(value, location)
    return
  }
  violation(location, "technical field has no canonical grammar", value)
}

function validate_identity(text, location,    plain, words, count, item, value) {
  if (!dynamic_bytes_complete(text, location, 0)) return
  plain = trim_space(decode_html(text))
  if (plain == "") return
  count = split(plain, words, /[ \t\r\n,;:\/=()]+/)
  for (item = 1; item <= count; item++) {
    value = words[item]
    if (value == "") continue
    if (value in ISSUED) continue
    violation(location, "identity field is not an issued pseudotoken", value)
  }
}

function validate_evidence(text, location,    plain, words, count, item, value, markers) {
  if (!dynamic_bytes_complete(text, location, 0)) return
  plain = trim_space(decode_html(text))
  if (plain == "") return
  count = split(plain, words, /[ \t\r\n]+/)
  markers = 0
  for (item = 1; item <= count; item++) {
    value = words[item]
    if (value == "[redacted-evidence-line]") {
      markers++
      continue
    }
    if (value != "" && !(value in ISSUED)) \
      violation(location, "unissued pseudotoken in projected field", value)
  }
  if (markers < 1) \
    violation(location, \
      "projected field lacks the canonical removal marker", plain)
}

function suspicious_single_word(text,    plain) {
  plain = trim_space(decode_html(text))
  if (plain !~ /^[a-z][a-z0-9_-]*$/) return 0
  return plain != "none" && plain != "unreadable"
}

function validate_observed(text, location) {
  validate_evidence(text, location)
}

function canonical_copy(copy_id,    finding_id) {
  if (copy_id ~ /^finding-label:.*:v1$/) {
    finding_id = copy_id
    sub(/^finding-label:/, "", finding_id)
    sub(/:v1$/, "", finding_id)
    if (finding_id in FINDING_LABEL) return FINDING_LABEL[finding_id]
    return ""
  }
  if (copy_id == "raw-privacy-callout-v1") \
    return "This raw report contains identifying system data. Create a separate pseudonymized review copy before sharing: ./aixray-review-pack.sh --pseudonymize <this-report>. Inspect the review copy and local removals manifest before anything leaves this machine."
