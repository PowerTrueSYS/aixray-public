function canonical_structural_text(value) {
  value = normalize_space(decode_html(value))
  if (value == "" || (value in STRUCTURAL)) return 1
  if (value ~ /^[0-9]+ pass · [0-9]+ warn · [0-9]+ fail( · [0-9]+ not assessed)?( · [0-9]+ n\/a)?$/) \
    return 1
  if (value ~ /^[0-9]+ action[(]s[)] · complete · worst first$/) return 1
  return 0
}

function valid_title_text(value,    token) {
  value = normalize_space(decode_html(value))
  if (value == "QR code — send your results for a mitigation Blueprint") \
    return 1
  for (token in ISSUED) {
    if (ISSUED[token] != "host") continue
    if (value == "AIXray — " token \
        || value == "AIXray compliance — DISA STIG (IBM AIX 7.x) — " token \
        || value == "AIXray compliance — PowerTrue CIS L1 cross-check — " token \
        || value == "AIXray compliance — PowerTrue CIS L2 cross-check — " token \
        || value == "AIXray compliance — FFIEC IT Handbook — " token) return 1
  }
  return 0
}

function valid_finding_id(value,    token) {
  if (value in KNOWN_FINDING) return 1
  if (value !~ /^savevg_[[]vg-[0-9]+[]]$/) return 0
  token = value
  sub(/^savevg_[[]/, "", token)
  sub(/[]]$/, "", token)
  return (token in ISSUED) && ISSUED[token] == "vg"
}

