function char_count(value,    count) {
  count = 0
  while (substr(value, count + 1, 1) != "") count++
  return count
}

function replace_text(text, old, replacement,    result, position) {
  if (old == "") return text
  result = ""
  while ((position = index(text, old)) > 0) {
    result = result substr(text, 1, position - 1) replacement
    text = substr(text, position + char_count(old))
  }
  return result text
}

function decode_html(text) {
  text = replace_text(text, "&quot;", "\"")
  text = replace_text(text, "&#39;", "'")
  text = replace_text(text, "&nbsp;", " ")
  text = replace_text(text, "&lt;", "<")
  text = replace_text(text, "&gt;", ">")
  text = replace_text(text, "&amp;", "&")
  return text
}

function validate_entities(text, location,    remaining) {
  remaining = text
  gsub(/&quot;/, "", remaining)
  gsub(/&#39;/, "", remaining)
  gsub(/&nbsp;/, "", remaining)
  gsub(/&lt;/, "", remaining)
  gsub(/&gt;/, "", remaining)
  gsub(/&amp;/, "", remaining)
  if (remaining ~ /&#[xX]?[0-9A-Fa-f]+;/) \
    violation(location, "numeric HTML entity is not canonical", "")
  if (remaining ~ /&[A-Za-z][A-Za-z0-9]+;/) \
    violation(location, "unknown named HTML entity", "")
  if (remaining ~ /&#|&[A-Za-z][A-Za-z0-9]+/) \
    violation(location, "ambiguous or malformed HTML entity", "")
}

function strip_edges(value,    character) {
  while (value != "") {
    character = substr(value, 1, 1)
    if (character !~ /[\[({"']/) break
    value = substr(value, 2)
  }
  while (value != "") {
    character = substr(value, char_count(value), 1)
    if (character !~ /[\].,;!?)}"']/) break
    value = substr(value, 1, char_count(value) - 1)
  }
  return value
}

function trim_space(value) {
  sub(/^[ \t\r\n]+/, "", value)
  sub(/[ \t\r\n]+$/, "", value)
  return value
}

function normalize_space(value) {
  gsub(/[ \t\r\n]+/, " ", value)
  return trim_space(value)
}

function literal_count(text, needle,    count, remainder, position) {
  if (needle == "") return 0
  count = 0
  remainder = text
  while ((position = index(remainder, needle)) > 0) {
    count++
    remainder = substr(remainder, position + char_count(needle))
  }
  return count
}

