function canonical_plan_qr_path(row, y,    out, run_start, position, module, width) {
  out = ""
  run_start = 0
  for (position = 1; position <= char_count(row) + 1; position++) {
    module = position <= char_count(row) ? substr(row, position, 1) : "0"
    if (module == "1" && run_start == 0) {
      run_start = position
    } else if (module == "0" && run_start != 0) {
      width = position - run_start
      if (out != "") out = out " "
      out = out "M" (run_start + 3) " " y \
        "h" width "v1h-" width "z"
      run_start = 0
    }
  }
  return out
}

function canonical_plan_qr_path_index(value,    row_number) {
  for (row_number = 1; row_number <= 49; row_number++) {
    if (value == canonical_plan_qr_path( \
        PLAN_QR_ROW[row_number], row_number + 3)) return row_number
  }
  return 0
}

function canonical_plan_qr_svg(    svg, row_number) {
  svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 57 57\" width=\"32mm\" height=\"32mm\" shape-rendering=\"crispEdges\" role=\"img\" aria-labelledby=\"plan-qr-title plan-qr-description\">\n"
  svg = svg "  <title id=\"plan-qr-title\">QR code — send your results for a mitigation Blueprint</title>\n"
  svg = svg "  <desc id=\"plan-qr-description\">Alternate path to powertruesystems.com/assessment/</desc>\n"
  svg = svg "  <rect x=\"0\" y=\"0\" width=\"57\" height=\"57\" fill=\"#fff\"/>\n"
  for (row_number = 1; row_number <= 49; row_number++) {
    svg = svg "  <path fill=\"#000\" d=\"" \
      canonical_plan_qr_path(PLAN_QR_ROW[row_number], row_number + 3) \
      "\"/>\n"
  }
  return svg "</svg>"
}

function canonical_plan_link_url() {
  return "https://powertruesystems.com/assessment/?utm_source=aixray&utm_medium=report&utm_campaign=plan_reentry&utm_content=link#guided"
}

function canonical_plan_qr_url() {
  return "https://powertruesystems.com/assessment/?utm_source=aixray&utm_medium=report&utm_campaign=plan_reentry&utm_content=qr#guided"
}

function canonical_plan_intent(priority_count) {
  if (priority_count == 0) return "get your Blueprint"
  if (priority_count == 1) return "your top 1 fix → get your Blueprint"
  return "your top " priority_count " fixes → get your Blueprint"
}

function canonical_plan_card(priority_count,    card) {
  card = "<aside class=\"plan-card\" data-aixray-plan-card=\"\" data-copy-status=\"Next step\" data-plan-priority-count=\"" priority_count "\" data-plan-qr-url=\"" canonical_plan_qr_url() "\" aria-labelledby=\"plan-card-heading\">\n"
  card = card "  <div class=\"plan-card-main\">\n"
  card = card "    <div class=\"plan-card-copy\">\n"
  card = card "      <p class=\"plan-copy-status\">Next step</p>\n"
  card = card "      <h2 id=\"plan-card-heading\">" \
    canonical_plan_intent(priority_count) "</h2>\n"
  card = card "      <p class=\"plan-link\"><a href=\"" \
    canonical_plan_link_url() \
    "\">Send your results to PowerTrue and receive a Blueprint for mitigating the issues found.</a></p>\n"
  card = card "      <p class=\"plan-fallback\">powertruesystems.com/assessment/</p>\n"
  card = card "    </div>\n"
  card = card "    <figure class=\"plan-qr\">\n"
  card = card canonical_plan_qr_svg() "\n"
  card = card "      <figcaption>Scan to send your results and get your Blueprint</figcaption>\n"
  card = card "    </figure>\n"
  card = card "  </div>\n"
  card = card "  <div class=\"plan-safe-send\" role=\"note\">\n"
  card = card "    <p>Your report contains your hostname, addresses, and configuration. To send a redacted copy instead, run: ./aixray-review-pack.sh &lt;this-report&gt; — it writes a review file and a separate local decoding key that never leaves this machine.</p>\n"
  card = card "    <p class=\"plan-inspect-before-send\">Inspect the review file in your browser before sending it.</p>\n"
  card = card "    <p class=\"plan-review-mailbox\"><a href=\"#\">Send your review file to review@powertruesystems.com — we’ll return your mitigation Blueprint.</a></p>\n"
  return card "  </div>\n</aside>"
}

function plan_markup_signal_count(document,    lower) {
  lower = tolower(document)
  return literal_count(document, "data-aixray-plan-card") \
    + literal_count(document, "data-plan-qr-url") \
    + literal_count(document, canonical_plan_link_url()) \
    + literal_count(document, canonical_plan_qr_url()) \
    + literal_count(lower, "<aside") \
    + literal_count(lower, "<figure") \
    + literal_count(lower, "<figcaption") \
    + literal_count(lower, "<svg") \
    + literal_count(lower, "<desc") \
    + literal_count(lower, "<rect") \
    + literal_count(lower, "<path")
}

function validate_plan_contract(document,    lower, card_count, priority_count) {
  if (plan_markup_signal_count(document) == 0) return
  lower = tolower(document)
  card_count = 0
  for (priority_count = 0; priority_count <= 5; priority_count++) \
    card_count += literal_count(document, canonical_plan_card(priority_count))
  if (card_count != 1 \
      || literal_count(document, "data-aixray-plan-card") != 1 \
      || literal_count(document, "data-plan-qr-url") != 1 \
      || literal_count(document, canonical_plan_link_url()) != 1 \
      || literal_count(document, canonical_plan_qr_url()) != 1 \
      || literal_count(document, canonical_plan_qr_svg()) != 1 \
      || literal_count(document, "<path fill=\"#000\" d=\"") != 49 \
      || literal_count(document, "plan-qr-title") != 2 \
      || literal_count(document, "plan-qr-description") != 2 \
      || literal_count(lower, "<aside") != 1 \
      || literal_count(lower, "</aside>") != 1 \
      || literal_count(lower, "<figure") != 1 \
      || literal_count(lower, "</figure>") != 1 \
      || literal_count(lower, "<figcaption") != 1 \
      || literal_count(lower, "</figcaption>") != 1 \
      || literal_count(lower, "<svg") != 1 \
      || literal_count(lower, "</svg>") != 1 \
      || literal_count(lower, "<desc") != 1 \
      || literal_count(lower, "</desc>") != 1 \
      || literal_count(lower, "<rect") != 1 \
      || literal_count(lower, "<path") != 49) \
    violation("plan-card", \
      "Plan QR vector does not match the canonical live-card contract", "")
}

function canonical_plan_attribute(tag, name, value,    element) {
  element = tag_name(tag)
  if (element == "aside") {
    if (name == "data-aixray-plan-card") return value == ""
    if (name == "data-copy-status") \
      return value == "Next step"
    if (name == "data-plan-priority-count") return value ~ /^[0-5]$/
    if (name == "data-plan-qr-url") return value == canonical_plan_qr_url()
    if (name == "aria-labelledby") return value == "plan-card-heading"
  }
  if (element == "svg") {
    if (name == "xmlns") return value == "http://www.w3.org/2000/svg"
    if (name == "viewbox") return value == "0 0 57 57"
    if (name == "width" || name == "height") return value == "32mm"
    if (name == "shape-rendering") return value == "crispEdges"
    if (name == "role") return value == "img"
    if (name == "aria-labelledby") \
      return value == "plan-qr-title plan-qr-description"
  }
  if (element == "rect") {
    if (name == "x" || name == "y") return value == "0"
    if (name == "width" || name == "height") return value == "57"
    if (name == "fill") return value == "#fff"
  }
  if (element == "path") {
    if (name == "fill") return value == "#000"
    if (name == "d") return canonical_plan_qr_path_index(value) != 0
  }
  if (element == "a" && name == "href") \
    return value == canonical_plan_link_url()
  return 0
}

function strip_canonical_plan_resources(text) {
  text = replace_text(text, canonical_plan_link_url(), "")
  text = replace_text(text, canonical_plan_qr_url(), "")
  return replace_text(text, "http://www.w3.org/2000/svg", "")
}

function field_value(tag, name,    lower, marker, position, remainder, ending) {
  lower = tolower(tag)
  marker = tolower(name) "=\""
  position = index(lower, marker)
  if (position > 0) {
    remainder = substr(tag, position + char_count(marker))
    ending = index(remainder, "\"")
    if (ending > 0) return substr(remainder, 1, ending - 1)
  }
  marker = tolower(name) "='"
  position = index(lower, marker)
  if (position > 0) {
    remainder = substr(tag, position + char_count(marker))
    ending = index(remainder, "'")
    if (ending > 0) return substr(remainder, 1, ending - 1)
  }
  return ""
}

function field_count(tag, name,    lower, needle) {
  lower = tolower(tag)
  needle = tolower(name) "="
  return literal_count(lower, needle)
}

function tag_name(tag,    name) {
  name = tag
  sub(/^<[ \t\r\n]*/, "", name)
  sub(/^[\/!?][ \t\r\n]*/, "", name)
  sub(/[ \t\r\n>\/].*$/, "", name)
  return tolower(name)
}

function is_void_element(name) {
  return name == "meta" || name == "link" || name == "img" \
    || name == "br" || name == "hr" || name == "input" \
    || name == "area" || name == "base" || name == "col" \
    || name == "embed" || name == "param" || name == "source" \
    || name == "track" || name == "wbr" \
    || name == "path" || name == "rect"
}

function allowed_element(name) {
  return name == "a" || name == "aside" || name == "b" \
    || name == "body" || name == "br" || name == "code" \
    || name == "desc" || name == "div" || name == "figcaption" \
    || name == "figure" || name == "footer" || name == "h1" \
    || name == "h2" || name == "head" || name == "html" \
    || name == "li" || name == "meta" || name == "ol" \
    || name == "p" || name == "path" || name == "rect" \
    || name == "section" || name == "span" || name == "strong" \
    || name == "style" || name == "svg" || name == "table" \
    || name == "tbody" || name == "td" || name == "th" \
    || name == "thead" || name == "title" || name == "tr" \
    || name == "ul"
}

function allowed_family(value) {
  return value == "identity" || value == "observed" \
    || value == "evidence" || value == "technical" \
    || value == "authored"
}

function load_word_set(target, words,    pieces, count, item) {
  count = split(words, pieces, /[ \t\r\n]+/)
  for (item = 1; item <= count; item++) {
    if (pieces[item] != "") target[pieces[item]] = 1
  }
}

